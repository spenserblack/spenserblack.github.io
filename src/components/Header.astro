---
const pages: [
	description: string,
	link: string,
	attrs?: Record<string, string>,
][] = [
	["Homepage", "/"],
	["Ramblings", "/blog/"],
	["Projects", "/projects/"],
	["Steamdown", "/steamdown/", { title: "Markdown for Steam" }],
	["Nickname", "/wm-nickname/", { title: "Generate a nickname" }],
];
---

<header>
	<div class="dropdown-container">
		<button
			aria-expanded="false"
			aria-controls="nav-menu"
			id="nav-menu-button"
			class="primary">Navigation</button
		>
		<nav id="nav-menu">
			{
				pages.map(([description, link, attrs]) => (
					<a class="button primary" href={link} title={attrs?.title}>
						{description}
					</a>
				))
			}
		</nav>
	</div>
	<div class="controls">
		<button
			type="button"
			class="primary theme"
			popovertarget="settings-popover"
			popovertargetaction="toggle"
		>
			Settings
		</button>
		<div id="settings-popover" popover="auto">
			<h2>Settings</h2>
			<h3>Theme</h3>
			<button type="button" id="theme-system">System</button>
			<button type="button" id="theme-dark">Dark</button>
			<button type="button" id="theme-light">Light</button>
		</div>
	</div>
</header>

<script>
	const button = document.getElementById(
		"nav-menu-button",
	) as HTMLButtonElement;
	const menu = document.getElementById("nav-menu") as HTMLElement;
	const cls = "expanded";
	button.addEventListener("click", () => {
		if (menu.classList.contains(cls)) {
			menu.classList.remove(cls);
			button.setAttribute("aria-expanded", "false");
		} else {
			menu.classList.add(cls);
			button.setAttribute("aria-expanded", "true");
		}
	});
</script>
<script>
	import "../scripts/theme-dropdown";
</script>

<style lang="scss">
	header {
		display: flex;
		flex-direction: row;
		justify-content: space-around;
	}

	#nav-menu-button {
		display: none;
	}
	nav a {
		margin: 0 0.5rem;
	}
	@media screen and (max-width: 999px) {
		#nav-menu-button {
			display: unset;
		}
		nav {
			&.expanded {
				display: flex;
				flex-direction: column;
				margin-top: 0.5rem;
			}
			a {
				margin-bottom: 0.5rem;
			}
		}
	}
	nav {
		display: none;
	}
	@media screen and (min-width: 1000px) {
		nav {
			display: unset;
		}
	}

	#settings-popover {
		button {
			margin: 0.5rem;
		}
	}
</style>
